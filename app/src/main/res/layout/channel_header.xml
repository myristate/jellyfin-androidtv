<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2sp"
    android:background="@drawable/light_border">

    <TextView
        android:layout_width="96sp"
        android:layout_height="wrap_content"
        android:text="Small Text"
        android:id="@+id/channelName"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="2sp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="15sp" />

    <TextView
        android:layout_width="96sp"
        android:layout_height="wrap_content"
        android:text="Small Text"
        android:id="@+id/channelNumber"
        android:maxLines="1"
        android:textSize="12sp"
        android:layout_marginStart="3sp"
        android:layout_marginEnd="3sp"
        android:layout_below="@+id/channelName"
        android:layout_alignParentStart="true" />

    <org.jellyfin.androidtv.ui.AsyncImageView
        android:layout_width="56sp"
        android:layout_height="32sp"
        android:id="@+id/channelImage"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/channelName"
        android:scaleType="centerInside" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="12sp"
        android:id="@+id/favImage"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@+id/channelImage"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_heart_red"
        android:visibility="gone" />

    <!-- (Finly) Shown for a channel the tuner receives weakly, left of the favourite heart -->
    <ImageView
        android:layout_width="12sp"
        android:layout_height="12sp"
        android:id="@+id/signalImage"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@+id/channelImage"
        android:layout_marginEnd="14sp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_signal_weak"
        android:visibility="gone" />
</RelativeLayout>
